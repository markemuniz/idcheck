rules_version = '2';

// TTA ID Check: paste into Firebase console > Firestore Database > Rules.
// Stations sign in anonymously and can only ADD records. Only the manager
// emails below can READ reports. Nobody can edit or delete records.
// Keep managerEmails in sync with MANAGER_EMAILS in index.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function managerEmails() { return ['markemuniz@gmail.com', 'mark.muniz@thetravelagency.co']; }
    function isManager() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in managerEmails();
    }
    function validStore(s) { return s in ['soho', 'usq', 'dtbk', 'fifth']; }

    // One record per scan. No names, birth dates, ID numbers or addresses.
    match /idScans/{id} {
      allow create: if signedIn()
        && validStore(request.resource.data.store)
        && request.resource.data.result in ['clear', 'deny', 'check']
        && request.resource.data.keys().hasOnly(['at', 'day', 'hour', 'time', 'store', 'station', 'method',
             'result', 'reason', 'age', 'ageBand', 'issuer', 'country', 'docType', 'realId', 'flags', 'v',
             'ts', 'savedAt']);
      allow read: if isManager();
      allow update, delete: if false;
    }

    // Per-store daily totals. The Reports page reads only these.
    match /idDaily/{id} {
      allow create, update: if signedIn()
        && validStore(request.resource.data.store)
        && id == request.resource.data.day + '_' + request.resource.data.store;
      allow read: if isManager();
      allow delete: if false;
    }
  }
}
